# Copy this file to .env and fill in ONE provider. .env is listed in .gitignore: never commit your key.

# Which provider to use: openai, anthropic, google or nvidia
LLM_PROVIDER=openai

# Model name (optional; sensible defaults are used if blank: gpt-4o-mini / claude-haiku-5-5 / gemini-2.0-flash)
LLM_MODEL=

# Put the key for your chosen provider here and leave the others blank
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# NVIDIA (build.nvidia.com): set LLM_PROVIDER=nvidia, paste the key (it starts with nvapi-), leave the others blank.
# Default model: nvidia/nemotron-3.5-lightning-30b-a3b. Set LLM_MODEL to use another NVIDIA chat model.
NVIDIA_API_KEY=
# Optional: more keys for the same provider (NVIDIA_API_KEY_2 ... _9). The app uses them in turn, which spreads the calls over several rate limits.
NVIDIA_API_KEY_2=

# Seconds before an LLM call gives up (the app then uses its fallbacks; booking is refused if the red-flag check times out)
LLM_TIMEOUT=20

# How many times an AI call is retried after a short provider error (for example HTTP 429 "too many requests"). Default 4.
# Each attempt has its own LLM_TIMEOUT. If it still fails: fallbacks for the Fact and summary, and booking is refused.
LLM_MAX_RETRIES=4
# When the provider answers "429 too many requests", wait this many seconds before each further try (then give up and keep the safe behaviour).
LLM_RATE_LIMIT_WAITS=4,8,16

# Optional backups: if the main model fails or times out, these are tried in order before a booking is refused.
# Comma separated, "provider:model" or just a model name on the same provider. Leave blank to use only the main model.
# Example: LLM_FALLBACK_MODELS=nvidia:google/gemma-4-31b-it
LLM_FALLBACK_MODELS=

# ---- Iteration 3: embeddings for the clinic knowledge base ----
# local = free, runs on your PC, no key needed (default). Or: openai, google.
EMBEDDING_PROVIDER=local
# Optional model name. local default: sentence-transformers/all-MiniLM-L6-v2 | openai default: text-embedding-3-small
# If you change the embedding model, rebuild the index:  python build_index.py
EMBEDDING_MODEL=
